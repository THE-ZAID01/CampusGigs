# Copy to server/.env on the EC2 instance and fill in the <> values
PORT=5000
NODE_ENV=production
JWT_SECRET=<long-random-string>
DATABASE_URL=postgresql://postgres:<URL-ENCODED-PASSWORD>@<RDS-ENDPOINT>:5432/campusgigs
DB_SSL=true
S3_BUCKET=<your-bucket-name>
AWS_REGION=us-east-1
ALLOWED_DOMAINS=ves.ac.in
CLIENT_ORIGIN=http://<EC2-PUBLIC-IP>:5000
